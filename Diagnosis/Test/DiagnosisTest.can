/*@!Encoding:65001*/
/*
 * DiagnosisTest_Lib.can
 *
 * CAPL test library for the Chapter 15 diagnostic tests.
 * The XML Test Module DiagnosisTest.vxt owns the hierarchy and selection.
 *
 * This file must NOT contain a MainTest() function.
 *
 * Nodes/IPC.can remains the simulated ECU. Nodes/Tester.can is no longer
 * required: its vehicle start-up sequence moved to InitDiagnosis() below, and
 * its panel read/write logic moved to the exported diagnostic test cases.
 * This library sends diagnostic requests and checks the responses directly.
 */

includes
{
}

variables
{
  dword gTestStep;
  const dword RESPONSE_TIMEOUT = 15000;
  const dword SENDING_TIMEOUT  = 20000;

  char TEST_STEP[4] = "000";

  byte VIN[17] =
  {
    0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47, 0x48, 0x49,
    0x4A, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47
  };

  byte SERIAL_NUMBER[9] =
  {
    0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39
  };

  byte MANUFACTURING_DATE[3] = { 24, 6, 15 };
}

/* =========================================================================
 * Initialization called from XML <preparation>
 * ========================================================================= */

export testfunction InitDiagnosis()
{
  diagSetTarget("IPC");

  @Vehicle_Key::Unlock_Car = 1;
  @Vehicle_Key::Car_Driver = 0;
  @Vehicle_Key::Key_State  = 3;

  // The BCM simulation changes Key_State from 3 (Crank) to 2 (RUN) after
  // about 800 ms. Wait long enough for the nodes and diagnostic layer.
  testWaitForTimeout(2000);
}

export testfunction Diag_RestoreEngineValues()
{
  TestCaseComment("恢复发动机转速和温度到初始值");

  // 1. 先恢复温度（Speed_Up = 0 → EngTemp = 0，同时 Eng_Speed 被写成 0）
  @Vehicle_Control::Speed_Up = 0;
  testWaitForTimeout(300);

  // 2. 再显式恢复转速（防止 Key_State 不是 2 时映射没执行）
  @Vehicle_Control::Eng_Speed = 0;
  testWaitForTimeout(500);   // 等 Gateway 映射 + IPC 抓取报文

  // 3. 打印确认（可选，调试用）
  write("[恢复] Eng_Speed = %d, Speed_Up = %d, 总线 EngSpeed = %.2f, EngTemp = %.2f",
        @Vehicle_Control::Eng_Speed,
        @Vehicle_Control::Speed_Up,
        getSignal(EngineData::EngSpeed),
        getSignal(EngineData::EngTemp));
}

/* =========================================================================
 * Session control
 * ========================================================================= */

export testcase DiagTest_Session_Switch()
{
  long status;

  Diag_ResetTestStep();

  Diag_IncrementTestStep();
  TestCaseComment("切换至默认会话");
  status = Diag_SwitchToDefaultSession();
  if (status != 0)
  {
    TestStepFail(TEST_STEP, "默认会话切换失败！");
  }
  else
  {
    TestStepPass(TEST_STEP, "默认会话切换成功！");
  }

  Diag_IncrementTestStep();
  TestCaseComment("切换至扩展会话");
  status = Diag_SwitchToExtendedSession();
  if (status != 0)
  {
    TestStepFail(TEST_STEP, "扩展会话切换失败！");
  }
  else
  {
    TestStepPass(TEST_STEP, "会话延时切换成功！");
  }

  Diag_IncrementTestStep();
  TestCaseComment("再次切换至默认会话");
  status = Diag_SwitchToDefaultSession();
  if (status != 0)
  {
    TestStepFail(TEST_STEP, "默认会话切换失败！");
  }
  else
  {
    TestStepPass(TEST_STEP, "默认会话切换成功！");
  }
}

export testcase DiagTest_ProductionSessionFromDefault()
{
  diagRequest IPC.Production_Session_Start req;

  Diag_ResetTestStep();
  Diag_IncrementTestStep();
  TestCaseComment("在“默认会话”（Default Session）中，必须拒绝“生产会话”（Production Session）。");

  if (Diag_SwitchToDefaultSession() != 0)
  {
    TestStepFail(TEST_STEP, "无法进入默认会话");
    return;
  }

  Diag_IncrementTestStep();
  Diag_SendAndExpectNRC(req, 0x7E, "“默认会话”中的生产会话");
}

/* =========================================================================
 * VIN read/write
 * ========================================================================= */

export testcase DiagTest_VIN_WriteAndRead()
{
  long status;
  long copiedBytes;

  diagRequest IPC.Vehicle_Identification_Number_Write VIN_Write;
  diagRequest IPC.Vehicle_Identification_Number_Read VIN_ReadReq;
  byte VIN_Read[17];
  int i;

  Diag_ResetTestStep();

  // Step 01: Default session, then Extended session
  Diag_IncrementTestStep();
  TestCaseComment("切换至默认会话");
  status = Diag_SwitchToDefaultSession();
  if (status != 0)
  {
    TestStepFail(TEST_STEP, "默认会话切换失败！");
  }
  else
  {
    TestStepPass(TEST_STEP, "默认会话切换成功！");
  }

  TestCaseComment("切换至扩展会话");
  status = Diag_SwitchToExtendedSession();
  if (status != 0)
  {
    TestStepFail(TEST_STEP, "扩展会话切换失败！");
  }
  else
  {
    TestStepPass(TEST_STEP, "会话延时切换成功！");
  }

  // Step 02: Unlock Security Level 1, then Level 2
  if (Diag_SecurityLevel_1_Unlock() != 0)
  {
    TestStepFail(TEST_STEP, "安全级别 1 解锁失败！");
    return;
  }

  if (Diag_SecurityLevel_2_Unlock() != 0)
  {
    TestStepFail(TEST_STEP, "安全级别 2 解锁失败！");
    return;
  }

  // Step 03: Write VIN
  Diag_IncrementTestStep();
  TestCaseComment("写入 VIN 码");
  DiagSetParameterRaw(VIN_Write, "VIN", VIN, elcount(VIN));
  if (Diag_SendAndWait(VIN_Write, "VIN write") != 0)
  {
    return;
  }

  // Step 04: Back to Security Level 1, required for VIN read
  if (Diag_SecurityLevel_1_Unlock() != 0)
  {
    TestStepFail(TEST_STEP, "安全级别 1 解锁失败！");
    return;
  }

  // Step 05: Read and compare VIN
  Diag_IncrementTestStep();
  TestCaseComment("读取 VIN 码");
  if (Diag_SendAndWait(VIN_ReadReq, "VIN read") != 0)
  {
    return;
  }

  copiedBytes = diagGetRespParameterRaw(
                  VIN_ReadReq, "VIN", VIN_Read, elcount(VIN_Read));
  PrintByteArray(VIN_Read, elcount(VIN_Read));

  TestCaseComment("验证车辆识别码 (VIN)");
  for (i = 0; i < elcount(VIN); i++)
  {
    if (VIN_Read[i] != VIN[i])
    {
      TestStepFail(TEST_STEP,
                   "读取出的 VIN 与字节 %d 处的书写值不符！", i);
      return;
    }
  }

  TestStepPass(TEST_STEP, "读取出的VIN与书面记录的数值一致！");
}
// 将任意长度的 byte 数组转换为字符串并打印
void PrintByteArray(byte data[], dword dataLen)
{
  char str[256];   // 最大支持 255 字节
  dword i;
  dword len;

  // 防止缓冲区溢出
  len = dataLen;
  if (len > elcount(str) - 1) {
    len = elcount(str) - 1;
  }

  for (i = 0; i < len; i++) {
    str[i] = (char)data[i];
  }
  str[len] = '\0';

  write("数据(%d字节) = %s", len, str);
}
export testcase DiagTest_VINWriteWithoutSecurity()
{
  diagRequest IPC.Vehicle_Identification_Number_Write req;

  Diag_ResetTestStep();
  Diag_IncrementTestStep();
  TestCaseComment("在未进行安全解锁的情况下准备扩展会话");

  if (Diag_PrepareExtended() != 0)
  {
    TestStepFail(TEST_STEP, "无法进入扩展会话");
    return;
  }

  Diag_IncrementTestStep();
  DiagSetParameterRaw(req, "VIN", VIN, elcount(VIN));
  Diag_SendAndExpectNRC(req, 0x33, "在无安全保护的情况下写入 VIN");
}

/* =========================================================================
 * Manufacturing date
 * ========================================================================= */

export testcase DiagTest_ManufacturingDate_Write()
{
  diagRequest IPC.ECU_Manufacturing_Date_Write req;

  Diag_ResetTestStep();
  Diag_IncrementTestStep();
  TestCaseComment("准备扩展会话及安全级别 1");

  if (Diag_PrepareExtendedUnlock1() != 0)
  {
    TestStepFail(TEST_STEP, "无法准备会话/安全设置");
    return;
  }

  Diag_IncrementTestStep();
  req.SetParameter("Manufacturing_date_Year", MANUFACTURING_DATE[0]);
  req.SetParameter("Manufacturing_date_Month", MANUFACTURING_DATE[1]);
  req.SetParameter("Manufacturing_date_Day", MANUFACTURING_DATE[2]);

  if (Diag_SendAndWait(req, "Manufacturing date write") == 0)
  {
    TestStepPass(TEST_STEP, "接受标注生产日期");
  }
  else
  {
    TestStepFail(TEST_STEP, "生产日期写入失败");
  }
}

export testcase DiagTest_ManufacturingDate_Read()
{
  diagRequest IPC.ECU_Manufacturing_Date_Read req;
  long year;
  long month;
  long day;

  Diag_ResetTestStep();
  Diag_IncrementTestStep();
  TestCaseComment("准备扩展会话");

  if (Diag_PrepareExtended() != 0)
  {
    TestStepFail(TEST_STEP, "无法进入扩展会话");
    return;
  }

  Diag_IncrementTestStep();
  if (Diag_SendAndWait(req, "Manufacturing date read") != 0)
  {
    return;
  }

  year  = (long)diagGetRespParameter(req, "Manufacturing_date_Year");
  month = (long)diagGetRespParameter(req, "Manufacturing_date_Month");
  day   = (long)diagGetRespParameter(req, "Manufacturing_date_Day");

  if (year < 0 || year > 99 || month < 1 || month > 12 || day < 1 || day > 31)
  {
    TestStepFail(TEST_STEP,
                 "无效的生产日期：20%02d-%02d-%02d", year, month, day);
    return;
  }

  TestStepPass(TEST_STEP,
               "生产日期：20%02d-%02d-%02d", year, month, day);
}

/* =========================================================================
 * Serial number
 * ========================================================================= */

export testcase DiagTest_SerialNumber_WriteAndRead()
{
  diagRequest IPC.ECU_Serial_Number_Write writeReq;
  diagRequest IPC.ECU_Serial_Number_Read readReq;
  byte readBack[9];
  long copiedBytes;
  int i;

  Diag_ResetTestStep();
  Diag_IncrementTestStep();
  TestCaseComment("准备扩展会话及安全级别 1");

  if (Diag_PrepareExtendedUnlock1() != 0)
  {
    TestStepFail(TEST_STEP, "无法准备会话/安全设置");
    return;
  }

  Diag_IncrementTestStep();
  DiagSetParameterRaw(writeReq, "Serial_Number", SERIAL_NUMBER, elcount(SERIAL_NUMBER));
  if (Diag_SendAndWait(writeReq, "Serial number write") != 0)
  {
    return;
  }

  Diag_IncrementTestStep();
  if (Diag_SendAndWait(readReq, "Serial number read") != 0)
  {
    return;
  }

  copiedBytes = diagGetRespParameterRaw(
                  readReq, "Serial_Number", readBack, elcount(readBack));
//  if (copiedBytes < elcount(readBack))
//  {
//    TestStepFail(TEST_STEP, "序列号响应过短：%d 字节", copiedBytes);
//    return;
//  }

  for (i = 0; i < elcount(SERIAL_NUMBER); i++)
  {
    if (readBack[i] != SERIAL_NUMBER[i])
    {
      TestStepFail(TEST_STEP,
                   "在第 %d 字节处序列号不匹配！", i);
      return;
    }
  }

  TestStepPass(TEST_STEP, "回读的序列号与写入的数值一致！");
}

export testcase DiagTest_SerialNumber_Read()
{
  diagRequest IPC.ECU_Serial_Number_Read req;
  byte data[9];
  char dataStr[10];
  long copiedBytes;

  Diag_ResetTestStep();
  Diag_IncrementTestStep();
  TestCaseComment("准备扩展会话");

  if (Diag_PrepareExtended() != 0)
  {
    TestStepFail(TEST_STEP, "无法进入扩展会话");
    return;
  }

  Diag_IncrementTestStep();
  if (Diag_SendAndWait(req, "Serial number read") != 0)
  {
    return;
  }

  copiedBytes = diagGetRespParameterRaw(req, "Serial_Number", data, elcount(data));

  // ===== 3. 打印实际数据，供人工核对 =====
  //PrintByteArrayDebug("序列号读取", data, elcount(data));
  ByteArrayToStr(data, elcount(data), dataStr, elcount(dataStr));

  // ===== 4. 数据全 0 判失败（参数名不匹配的典型症状）=====
  if (data[0] == 0 && data[1] == 0 && data[2] == 0) {
    TestStepFail(TEST_STEP,
               "序列号数据为空（copiedBytes=%d），请检查参数名 'Serial_Number' 与 CDD 是否一致",
               copiedBytes);
    return;
  }

  // ===== 5. 判定为 Pass，报告里写真实数据而非 copiedBytes =====
  TestStepPass(TEST_STEP, "序列号读取成功：%s（Hex: 0x%02X...）", dataStr, data[0]);
}

/* =========================================================================
 * Variant coding
 * ========================================================================= */

export testcase DiagTest_VariantCoding_WriteAndRead()
{
  diagRequest IPC.Variant_Coding_Write writeReq;
  diagRequest IPC.Variant_Coding_Read readReq;

  double countryCode      = 1.0;
  double vehicleType      = 3.0;
  double beltWarning      = 1.0;
  double overSpeedWarning = 1.0;

  double readCountryCode;
  double readVehicleType;
  double readBeltWarning;
  double readOverSpeedWarning;

  Diag_ResetTestStep();
  Diag_IncrementTestStep();
  TestCaseComment("准备扩展会话及安全级别 1");

  if (Diag_PrepareExtendedUnlock1() != 0)
  {
    TestStepFail(TEST_STEP, "无法准备会话/安全设置");
    return;
  }

  Diag_IncrementTestStep();
  writeReq.SetParameter("Coding_String.Country_Code", countryCode);
  writeReq.SetParameter("Coding_String.Vehicle_Type", vehicleType);
  writeReq.SetParameter("Coding_String.Belt_Warning", beltWarning);
  writeReq.SetParameter("Coding_String.OverSpeed_Warning", overSpeedWarning);

  if (Diag_SendAndWait(writeReq, "Variant coding write") != 0)
  {
    return;
  }

  Diag_IncrementTestStep();
  if (Diag_SendAndWait(readReq, "Variant coding read") != 0)
  {
    return;
  }

  readCountryCode = diagGetRespParameter(
                      readReq, "Coding_String.Country_Code");
  readVehicleType = diagGetRespParameter(
                      readReq, "Coding_String.Vehicle_Type");
  readBeltWarning = diagGetRespParameter(
                      readReq, "Coding_String.Belt_Warning");
  readOverSpeedWarning = diagGetRespParameter(
                           readReq, "Coding_String.OverSpeed_Warning");

  if (readCountryCode != countryCode
      || readVehicleType != vehicleType
      || readBeltWarning != beltWarning
      || readOverSpeedWarning != overSpeedWarning)
  {
    TestStepFail(TEST_STEP,
                 "变异编码不匹配：%.0f/%.0f/%.0f/%.0f",
                 readCountryCode, readVehicleType,
                 readBeltWarning, readOverSpeedWarning);
    return;
  }

  TestStepPass(TEST_STEP, "变体编码回读值与写入值一致！");
}

export testcase DiagTest_VariantCoding_Read()
{
  diagRequest IPC.Variant_Coding_Read req;
  double countryCode;
  double vehicleType;
  double beltWarning;
  double overSpeedWarning;

  Diag_ResetTestStep();
  Diag_IncrementTestStep();
  TestCaseComment("准备扩展会话");

