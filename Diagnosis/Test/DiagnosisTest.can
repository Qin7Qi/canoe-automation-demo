  TestStepPass(TEST_STEP,
               "变体编码：%.0f/%.0f/%.0f/%.0f",
               countryCode, vehicleType, beltWarning, overSpeedWarning);
}

/* =========================================================================
 * Active session and DID reads
 * ========================================================================= */

export testcase DiagTest_ActiveSession_Read()
{
  diagRequest IPC.Active_Diagnostic_Session_Read req;
  long sessionType;

  Diag_ResetTestStep();
  Diag_IncrementTestStep();
  TestCaseComment("准备扩展会话");

  if (Diag_PrepareExtended() != 0)
  {
    TestStepFail(TEST_STEP, "无法进入扩展会话");
    return;
  }

  Diag_IncrementTestStep();
  if (Diag_SendAndWait(req, "Active session read") != 0)
  {
    return;
  }

  sessionType = (long)diagGetRespParameter(
                  req, "Diagnostic_Session_Type");

  if (sessionType != 0x03)
  {
    TestStepFail(TEST_STEP,
                 "当前会话为 0x%02x，预期为 0x03", sessionType);
    return;
  }

  TestStepPass(TEST_STEP, "当前会话为扩展会话 (0x03)");
}

export testcase DiagTest_DID_EngineSpeed_Read()
{
  diagRequest IPC.DID_Engine_Speed_Read req;
  byte data[8];
  long copiedBytes;

  Diag_ResetTestStep();
  Diag_IncrementTestStep();
  TestCaseComment("准备扩展会话");

  if (Diag_PrepareExtended() != 0)
  {
    TestStepFail(TEST_STEP, "无法进入扩展会话");
    return;
  }
  
  // ===== 2. 设置发动机转速 =====
  Diag_IncrementTestStep();
  TestCaseComment("设置发动机转速为 2000 rpm");

  @Vehicle_Key::Key_State = 2;       // Gateway 映射的前提条件
  testWaitForTimeout(300);

  @Vehicle_Control::Eng_Speed = 2000;
  testWaitForTimeout(500);           // 等 Gateway 映射 + IPC 抓取报文

  write("[设置后] @Eng_Speed = %d, 总线 EngSpeed = %.2f",
        @Vehicle_Control::Eng_Speed, getSignal(EngineData::EngSpeed));

  // ===== 3. 读取 DID =====
  Diag_IncrementTestStep();
  if (Diag_SendAndWait(req, "DID engine speed read") != 0)
  {
    return;
  }

  // 2. 提取数据（不依赖返回值）
  copiedBytes = diagGetRespParameterRaw(req, "DID_Engine_Speed", data, elcount(data));
  write("[调试] copiedBytes = %d, data[0]=0x%02X, data[1]=0x%02X",
      copiedBytes, data[0], data[1]);

  // 3. 用数据本身判断有效性（而不是返回值）
  //    如果 DID 定义是 2 字节，且第一个字节非 0，基本可判定读取成功
  if (data[0] == 0 && data[1] == 0) {
    TestStepFail(TEST_STEP, "DID 发动机转速数据为空（可能参数名不匹配）");
    return;
  }

  TestStepPass(TEST_STEP, "DID 发动机转速读取成功：%d",
               ByteArrayToValueBE(data, 2));
  
  Diag_RestoreEngineValues();
}

export testcase DiagTest_DID_EngineTemperature_Read()
{
  diagRequest IPC.DID_Engine_Temperature_Read req;
  byte data[4];
  char dataStr[5];
  long copiedBytes;

  Diag_ResetTestStep();
  Diag_IncrementTestStep();
  TestCaseComment("准备扩展会话");

  if (Diag_PrepareExtended() != 0)
  {
    TestStepFail(TEST_STEP, "无法进入扩展会话");
    return;
  }
  
  // ===== 2. 设置发动机温度 =====
  Diag_IncrementTestStep();
  TestCaseComment("设置发动机温度为 90℃");

  @Vehicle_Key::Key_State = 2;
  testWaitForTimeout(300);

  // Speed_Up = 60 → Gateway 设置 $EngTemp = 60 × 1.5 = 90
  @Vehicle_Control::Speed_Up = 60;
  testWaitForTimeout(500);

  // 注意：Speed_Up 会把 Eng_Speed 改成 2400，如果不需要可以覆盖回来
  // @Vehicle_Control::Eng_Speed = 0;

  write("[设置后] Speed_Up = %d, 总线 EngTemp = %.2f",
        @Vehicle_Control::Speed_Up, getSignal(EngineData::EngTemp));

  // ===== 3. 读取 DID =====
  Diag_IncrementTestStep();
  if (Diag_SendAndWait(req, "DID 发动机温度读数") != 0)
  {
    return;
  }

  // ===== 2. 提取数据（不依赖返回值）=====
  copiedBytes = diagGetRespParameterRaw(
                req, "DID_Engine_Temperature", data, elcount(data));

  // ===== 3. 打印数据，供人工核对 =====
  //PrintByteArrayDebug("DID 发动机温度读数", data, 4);
  ByteArrayToStr(data, 4, dataStr, 5);

  // ===== 4. 温度 0 是合法值，只做提示，不判失败 =====
  //    但如果 copiedBytes 返回 0 且 data[0] 也是 0，
  //    有可能是参数名不匹配，值得人工看一眼
  if (copiedBytes <= 0 && data[0] == 0) {
    TestCaseComment("提示：温度数据为 0");
  }

  // ===== 5. 判定为 Pass =====
  TestStepPass(TEST_STEP,
             "DID 发动机温度读数：%d（Hex: 0x%02X）", ByteArrayToValueLE(data, 1), data[0]);
  
  Diag_RestoreEngineValues();
}
void ByteArrayToStr(byte data[], dword dataLen, char outStr[], dword outStrSize)
{
  dword i;
  dword len;

  // 防止缓冲区溢出：最多填 outStrSize-1 个字符，留一个位置给 '\0'
  len = dataLen;
  if (len > outStrSize - 1) {
    len = outStrSize - 1;
  }

  for (i = 0; i < len; i++) {
    outStr[i] = (char)data[i];
  }
  outStr[len] = '\0';
}
dword ByteArrayToValueLE(byte data[], dword dataLen)
{
  dword value = 0;
  dword i;

  // 最多拼 4 字节（dword 是 32 位）
  if (dataLen > 4) dataLen = 4;

  for (i = 0; i < dataLen; i++) {
    value |= ((dword)data[i]) << (i * 8);
  }
  return value;
}
dword ByteArrayToValueBE(byte data[], dword dataLen)
{
  dword value = 0;
  dword i;

  if (dataLen > 4) dataLen = 4;

  for (i = 0; i < dataLen; i++) {
    value = (value << 8) | (dword)data[i];
  }
  return value;
}
// 同时打印十六进制原始值和可读字符串，便于排查乱码问题
// 将 0~15 的数值转换为对应的十六进制字符
char NibbleToHex(byte n)
{
  if (n < 10) {
    return (char)('0' + n);
  }
  return (char)('A' + (n - 10));
}

// 同时打印 byte 数组的 Hex 值和可读字符串
void PrintByteArrayDebug(char label[], byte data[], dword dataLen)
{
  char hexStr[512];
  char str[256];
  dword i;
  dword len;
  dword pos;

  // 防止缓冲区溢出
  len = dataLen;
  if (len > elcount(str) - 1) {
    len = elcount(str) - 1;
  }

  // ===== 手动构造 Hex 字符串 =====
  pos = 0;
  for (i = 0; i < len; i++) {
    if (pos + 4 >= elcount(hexStr)) {
      break;   // 空间不足，停止拼接
    }
    hexStr[pos]     = NibbleToHex((byte)(data[i] >> 4));      // 高 4 位
    hexStr[pos + 1] = NibbleToHex((byte)(data[i] & 0x0F));    // 低 4 位
    hexStr[pos + 2] = ' ';
    pos = pos + 3;
  }
  hexStr[pos] = '\0';   // 手动补结束符

  // ===== 构造可读字符串 =====
  for (i = 0; i < len; i++) {
    str[i] = (char)data[i];
  }
  str[len] = '\0';      // 手动补结束符

  // ===== 打印 =====
  write("[%s] Hex: %s", label, hexStr);
  write("[%s] Str: %s", label, str);
}
export testcase DiagTest_PowerSupplyVoltage_Read()
{
  diagRequest IPC.Power_Supply_Voltage_Read req;
  double voltage;

  Diag_ResetTestStep();
  Diag_IncrementTestStep();
  TestCaseComment("准备扩展会话");

  if (Diag_PrepareExtended() != 0)
  {
    TestStepFail(TEST_STEP, "无法进入扩展会话");
    return;
  }

  Diag_IncrementTestStep();
  if (Diag_SendAndWait(req, "Power supply voltage read") != 0)
  {
    return;
  }

  voltage = diagGetRespParameter(req, "DataRecord");
  TestStepPass(TEST_STEP, "电源电压：%.1f", voltage);
}

/* =========================================================================
 * Diagnostic helpers
 * ========================================================================= */

long Diag_SendAndWait(diagRequest * req, char stepName[])
{
  long status;

  // 1. 发送请求，检查调用是否成功
  if (diagSendRequest(req) != 0) {
    TestStepFail(TEST_STEP, "%s：diagSendRequest 调用失败", stepName);
    return -2;
  }
  
  // 2. 等待请求真正发出
  if (TestWaitForDiagRequestSent(req, SENDING_TIMEOUT) != 1)
  {
    TestStepFail(TEST_STEP, "%s：请求发送失败", stepName);
    return -2;
  }
  
  // 3. 等待 ECU 响应
  if (TestWaitForDiagResponse(req, RESPONSE_TIMEOUT) != 1)
  {
    TestStepFail(TEST_STEP, "%s：无响应", stepName);
    return -3;
  }
  
  // 4. 解析响应码
  status = diagGetLastResponseCode(req);

  if (status == -1)
  {
    TestStepPass(TEST_STEP, "%s：肯定回应", stepName);
    return 0;
  }

  if (status > 0)
  {
    TestStepFail(TEST_STEP,
                 "%s：否定响应 0x%.2x", stepName, status);
    return status;
  }

  TestStepFail(TEST_STEP, "%s：响应超时", stepName);
  return -1;
}

long Diag_SendAndExpectNRC(diagRequest * req, long expectedNrc, char stepName[])
{
  long status;

  diagSendRequest(req);

  if (TestWaitForDiagRequestSent(req, SENDING_TIMEOUT) != 1)
  {
    TestStepFail(TEST_STEP, "%s：请求发送失败", stepName);
    return -2;
  }

  if (TestWaitForDiagResponse(req, RESPONSE_TIMEOUT) != 1)
  {
    TestStepFail(TEST_STEP, "%s：无响应", stepName);
    return -3;
  }

  status = diagGetLastResponseCode(req);

  if (status == expectedNrc)
  {
    TestStepPass(TEST_STEP,
                 "%s：预期收到 NRC 0x%.2x", stepName, expectedNrc);
    return 0;
  }

  if (status == -1)
  {
    TestStepFail(TEST_STEP,
                 "%s：收到肯定响应，预期应为 NRC 0x%.2x",
                 stepName, expectedNrc);
  }
  else
  {
    TestStepFail(TEST_STEP,
                 "%s：收到 NRC 0x%.2x，预期为 0x%.2x",
                 stepName, status, expectedNrc);
  }

  return 1;
}

long Diag_SwitchToDefaultSession()
{
  diagRequest IPC.DefaultSession_Start req;

  if (Diag_SendAndWait(req, "默认会话") != 0)
  {
    return 1;
  }
  return 0;
}

long Diag_SwitchToExtendedSession()
{
  diagRequest IPC.ExtendedDiagnosticSession_Start req;

  if (Diag_SendAndWait(req, "扩展会话") != 0)
  {
    return 1;
  }
  return 0;
}

long Diag_PrepareExtended()
{
  if (Diag_SwitchToDefaultSession() != 0)
  {
    return -1;
  }

  if (Diag_SwitchToExtendedSession() != 0)
  {
    return -1;
  }

  return 0;
}

long Diag_PrepareExtendedUnlock1()
{
  if (Diag_PrepareExtended() != 0)
  {
    return -1;
  }

  if (Diag_SecurityLevel_1_Unlock() != 0)
  {
    return -1;
  }

  return 0;
}

long Diag_SecurityLevel_1_Unlock()
{
  diagRequest IPC.SeedLevel1_Request seedReq;
  diagRequest IPC.KeyLevel1_Send keyReq;

  byte seed[4];
  byte L_key[4];
  dword actualLevel = 1;
  char variant[6] = "";
  char ipOption[2] = "a";
  dword keyActualSize = 0;
  long status;

  diagSetTarget("IPC");
  Diag_IncrementTestStep();
  TestCaseComment("请求安全级别 1 种子值");

  if (Diag_SendAndWait(seedReq, "Security Level 1 seed") != 0)
  {
    return -1;
  }

  if (diagGetRespParameterRaw(seedReq, "SecuritySeed", seed, elcount(seed)) < 0)
  {
    TestStepFail(TEST_STEP, "无法读取安全级别 1 的种子值");
    return -1;
  }

  TestCaseComment("生成安全级别 1 密钥");
  status = DiagGenerateKeyFromSeed(
             seed, elcount(seed), actualLevel, variant, ipOption,
             L_key, elcount(L_key), keyActualSize);

  if (status != 0)
  {
    TestStepFail(TEST_STEP,
                 "DiagGenerateKeyFromSeed 失败，错误代码为 %d", status);
    return -1;
  }

  TestStepPass(TEST_STEP,
               "已生成安全级别 1 密钥，大小 = %d", keyActualSize);

  DiagSetParameterRaw(keyReq, "SecurityKey", L_key, elcount(L_key));
  TestCaseComment("发送安全级别 1 密钥");

  if (Diag_SendAndWait(keyReq, "Security Level 1 key") != 0)
  {
    return -1;
  }

  return 0;
}

long Diag_SecurityLevel_2_Unlock()
{
  diagRequest IPC.Seed_Level_2_Request seedReq;
  diagRequest IPC.Key_Level_2_Send keyReq;

  byte seed[4];
  byte L_key[4];
  dword actualLevel = 3;
  char variant[6] = "";
  char ipOption[2] = "a";
  dword keyActualSize = 0;
  long status;

  diagSetTarget("IPC");
  Diag_IncrementTestStep();
  TestCaseComment("请求安全级别 2 种子值");

  if (Diag_SendAndWait(seedReq, "安全级别 2 种子") != 0)
  {
    return -1;
  }

  if (diagGetRespParameterRaw(seedReq, "SecuritySeed", seed, elcount(seed)) < 0)
  {
    TestStepFail(TEST_STEP, "无法读取安全级别 2 的种子值");
    return -1;
  }

  TestCaseComment("生成安全级别 2 密钥");
  status = DiagGenerateKeyFromSeed(
             seed, elcount(seed), actualLevel, variant, ipOption,
             L_key, elcount(L_key), keyActualSize);

  if (status != 0)
  {
    TestStepFail(TEST_STEP,
                 "DiagGenerateKeyFromSeed 失败，错误代码为 %d", status);
    return -1;
  }

  TestStepPass(TEST_STEP,
               "已生成安全级别 2 密钥，大小 = %d", keyActualSize);

  DiagSetParameterRaw(keyReq, "SecurityKey", L_key, elcount(L_key));
  TestCaseComment("发送安全级别 2 密钥");

  if (Diag_SendAndWait(keyReq, "Security Level 2 key") != 0)
  {
    return -1;
  }

  return 0;
}

void Diag_ResetTestStep()
{
  gTestStep = 0;
}

void Diag_IncrementTestStep()
{
  if (gTestStep < 10)
  {
    snprintf(TEST_STEP, elcount(TEST_STEP), "00%d", gTestStep);
  }
  else if (gTestStep < 100)
  {
    snprintf(TEST_STEP, elcount(TEST_STEP), "0%d", gTestStep);
  }
  else
  {
    snprintf(TEST_STEP, elcount(TEST_STEP), "%d", gTestStep);
  }

  gTestStep++;
}
