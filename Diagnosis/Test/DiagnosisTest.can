  countryCode = diagGetRespParameter(
                  req, "Coding_String.Country_Code");
  vehicleType = diagGetRespParameter(
                  req, "Coding_String.Vehicle_Type");
  beltWarning = diagGetRespParameter(
                  req, "Coding_String.Belt_Warning");
